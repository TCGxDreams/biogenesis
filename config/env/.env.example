# Copy this to .env and fill in your values

# ---- Frontend ----
# Local development
VITE_BACKEND_URL=http://localhost:8000

# Production (Render backend)
# VITE_BACKEND_URL=https://biogenesis-8ebk.onrender.com

# ---- Backend (backend/server.py) ----
# Browser origins allowed to call the API, comma separated.
# Defaults to http://localhost:5173 when unset.
ALLOWED_ORIGINS=http://localhost:5173

# Largest accepted PDB payload, in bytes. Default 5 MB.
MAX_PDB_BYTES=5242880

# Upper bound on the top_n parameter. Default 1000.
MAX_TOP_N=1000

# Per-IP rate limit. Defaults: 10 requests per 60 seconds.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Optional cloud account integration. Public browser credentials only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
